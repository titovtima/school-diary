# Основная переменная — единая строка подключения.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_diary

# Альтернатива: отдельные переменные. Используются, если DATABASE_URL не задана.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=school_diary

# Для Nuxt/Nitro (runtime config)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=school_diary
